# Gamenote API env vars (copy to .env / set in Vercel project settings)

# Twitch/IGDB application credentials:
# https://dev.twitch.tv/console/apps -> "IGDB API" access
IGDB_CLIENT_ID=your_igdb_client_id
IGDB_CLIENT_SECRET=your_igdb_client_secret

# Shared API secret for the Gamenote clients.
# Generate one: openssl rand -hex 32
# Set the SAME value as VITE_RAWG_API_KEY (web) and RAWG_API_KEY (mobile).
API_SECRET=your_gamenote_api_secret
